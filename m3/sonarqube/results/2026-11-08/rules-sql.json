      "repo": "SQLCC",
      "name": "Defined primary key is not using recommended naming convention",
      "createdAt": "2026-11-08T13:37:15-05:00",
      "severity": "MINOR",
      "status": "READY",
      "isTemplate": false,
      "tags": [],
      "sysTags": [
        "naming"
      ],
      "lang": "sql",
      "langName": "SQL",
      "params": [],
      "defaultDebtRemFnType": "LINEAR",
      "debtRemFnType": "LINEAR",
      "type": "CODE_SMELL",
      "defaultRemFnType": "LINEAR",
      "defaultRemFnGapMultiplier": "3min",
      "remFnType": "LINEAR",
      "remFnGapMultiplier": "3min",
      "remFnOverloaded": false,
      "scope": "MAIN",
      "isExternal": false,
      "descriptionSections": [
        {
          "key": "default",
          "content": "<h2>Description</h2><p>Defined primary key is not using recommended naming convention to start with PK_.</p><h2>Code examples</h2><h3>Non-compliant</h3><pre><code>CREATE TABLE dbo.Orders\r\n(\r\nId int NOT NULL,\r\nCONSTRAINT OrderID PRIMARY KEY CLUSTERED (Id) \r\n);  </code></pre><pre><code>CREATE TABLE dbo.Orders\r\n(\r\nId int NOT NULL,  \r\nPRIMARY KEY (Id)\r\n);  </code></pre><h3>Compliant</h3><pre><code>ALTER TABLE dbo.Orders ADD CONSTRAINT PK_OrderId PRIMARY KEY CLUSTERED (Id);</code></pre>"
        }
      ],
      "educationPrinciples": [],
      "updatedAt": "2026-11-08T13:37:15-05:00",
      "cleanCodeAttribute": "CONVENTIONAL",
      "cleanCodeAttributeCategory": "CONSISTENT",
      "impacts": [
