    {
      "key": "SQLCC:C005",
      "repo": "SQLCC",
      "name": "EXECUTE/EXEC for dynamic query is used",
      "createdAt": "2026-11-08T13:37:15-05:00",
      "severity": "MINOR",
      "status": "READY",
      "isTemplate": false,
