    {
      "key": "SQLCC:C015",
      "repo": "SQLCC",
      "name": "UNION operator is used",
      "createdAt": "2026-11-08T13:37:15-05:00",
      "severity": "MAJOR",
      "status": "READY",
      "isTemplate": false,
      "tags": [],
