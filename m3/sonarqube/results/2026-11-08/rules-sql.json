    {
      "key": "SQLCC:C014",
      "repo": "SQLCC",
      "name": "OR verb is used in a WHERE clause",
      "createdAt": "2026-11-08T13:37:15-05:00",
      "severity": "MAJOR",
      "status": "READY",
      "isTemplate": false,
      "tags": [],
      "sysTags": [
        "performance"
      ],
      "lang": "sql",
      "langName": "SQL",
      "params": [],
      "defaultDebtRemFnType": "LINEAR",
      "debtRemFnType": "LINEAR",
      "type": "CODE_SMELL",
      "defaultRemFnType": "LINEAR",
      "defaultRemFnGapMultiplier": "3min",
      "remFnType": "LINEAR",
      "remFnGapMultiplier": "3min",
      "remFnOverloaded": false,
      "scope": "MAIN",
      "isExternal": false,
      "descriptionSections": [
        {
          "key": "default",
          "content": "<h2>Description</h2><p>It is  advisable to consider using UNION/UNION ALL operator instead of OR verb in the WHERE clause.</p><h2>Code examples</h2><h3>Non-compliant</h3><pre><code>SELECT name, surname, count from dbo.test where name = 'Test' OR surname = 'Testor';</code></pre><h3>Compliant</h3><pre><code>SELECT name, surname, count from dbo.test where name = 'or' and surname = 'TestOR';</code></pre>"
        }
      ],
      "educationPrinciples": [],
