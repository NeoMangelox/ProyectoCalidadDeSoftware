    {
      "key": "SQLCC:C003",
      "repo": "SQLCC",
      "name": "INSERT statement without columns listed",
      "createdAt": "2026-11-08T13:37:15-05:00",
      "severity": "MINOR",
      "status": "READY",
      "isTemplate": false,
      "tags": [],
